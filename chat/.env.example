# Copy to chat/.env (gitignored). Chainlit loads it from this folder.
CAREER_API_URL=http://localhost:8000
# Same value as ADMIN_API_KEY in the API's .env; sent only on admin calls.
CAREER_ADMIN_API_KEY=
# Required by Chainlit for login sessions: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=
# One local account; defaults admin / admin. Change both before any public use.
CHAT_USERNAME=admin
CHAT_PASSWORD=admin
# Chat history file (default chat/.chats.db)
# CHAT_HISTORY_DB=
