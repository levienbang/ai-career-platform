# Copy to .env on the server (never commit it). Generate secrets with: openssl rand -hex 24
# Hex secrets avoid URL-escaping problems inside DATABASE_URL.
COMPOSE_FILE=docker-compose.prod.yml
DOMAIN=career.example.com            # or <server-ip>.sslip.io when you have no domain
DEMO_PASSWORD=change-me

POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me
POSTGRES_READONLY_USER=career_readonly
POSTGRES_READONLY_PASSWORD=change-me
# Same passwords as above.
DATABASE_URL=postgresql+psycopg://career:change-me@postgres:5432/career
READONLY_DATABASE_URL=postgresql+psycopg://career_readonly:change-me@postgres:5432/career

DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
QDRANT_COLLECTION=jobs_ai
LLM_TIMEOUT_SECONDS=120

# Required in production (the API refuses to start without them).
ADMIN_API_KEY=change-me              # the job pipeline sends it as X-API-Key
PUBLIC_RATE_LIMIT_PER_MINUTE=5
PUBLIC_DAILY_LIMIT=200
