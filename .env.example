APP_ENV=development
DATABASE_URL=postgresql+psycopg://career:career@postgres:5432/career
POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=career
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=30
HYBRID_CANDIDATE_LIMIT=20
RRF_K=60
RERANKER_PROVIDER=google
RERANKER_MODEL=gemini-3.5-flash
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_RETRIES=1
RERANKER_MAX_CANDIDATES=20
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jobs
QDRANT_TIMEOUT_SECONDS=10
MAX_IMPORT_BYTES=1000000
