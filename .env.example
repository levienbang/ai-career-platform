APP_ENV=development
DATABASE_URL=postgresql+psycopg://career:career@postgres:5432/career
READONLY_DATABASE_URL=postgresql+psycopg://career_readonly:change-me@postgres:5432/career
POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_READONLY_USER=career_readonly
POSTGRES_READONLY_PASSWORD=change-me
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_STRUCTURED_OUTPUT_METHOD=function_calling
DEEPSEEK_THINKING=disabled
# Backup model when a DeepSeek call fails: an open model on Amazon Bedrock through its
# OpenAI-compatible Mantle API. none | bedrock. Needs a Bedrock API key.
# Setup: the chat talks with Qwen (DeepSeek as its backup); the agent it calls (router,
# SQL, reranker, extraction) runs on DeepSeek with Qwen as the backup.
# Without a Bedrock key, set both to DeepSeek only: LLM_FALLBACK=none, CHAT_PROVIDER=deepseek.
LLM_FALLBACK=bedrock
CHAT_PROVIDER=bedrock
# Token budget for one chat model call; the oldest turns are dropped to fit it.
CHAT_CONTEXT_TOKENS=100000
BEDROCK_MODEL=qwen.qwen3-235b-a22b-2507
BEDROCK_REGION=us-east-1
BEDROCK_STRUCTURED_OUTPUT_METHOD=function_calling
AWS_BEARER_TOKEN_BEDROCK=
LLM_MAX_RETRIES=2
LLM_BATCH_SIZE=8
LLM_REQUESTS_PER_MINUTE=0
LLM_STRUCTURED_FAST_PATH=true
LLM_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
AGENT_SEARCH_LIMIT=5
AGENT_TOOL_MAX_RETRIES=1
SQL_MAX_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=3000
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=30
HYBRID_CANDIDATE_LIMIT=20
RRF_K=60
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_RETRIES=1
# Hybrid candidates the reranker reorders; 10 halves cross-encoder latency vs 20
RERANKER_MAX_CANDIDATES=10
# Milestone 15: local cross-encoder reranker (needs `uv sync --extra rerank`) and
# Vietnamese word segmentation for BM25. llm = DeepSeek reranker; regex = old tokenizer.
RERANKER_PROVIDER=llm
# On a request-time failure: cross_encoder (local model, then hybrid order), hybrid, or none (503)
RERANKER_FALLBACK=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=8
# 0 = one passage per job; e.g. 200 = header-prefixed sentence chunks, best chunk wins
RERANKER_CHUNK_WORDS=0
RERANKER_CHUNK_OVERLAP_WORDS=40
RERANKER_MAX_CHUNKS=4
# Empty = auto (cuda, then mps, then cpu); or cpu / mps / cuda
RERANKER_DEVICE=
KEYWORD_TOKENIZER=regex
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jobs
QDRANT_TIMEOUT_SECONDS=10
MAX_IMPORT_BYTES=1000000
MAX_CV_BYTES=2000000
MAX_CV_PAGES=5
CV_MATCH_CANDIDATES=50
CV_MATCH_SEMANTIC_WEIGHT=0.6
# Public deployment guards (empty/0 = off for local development)
ADMIN_API_KEY=
PUBLIC_RATE_LIMIT_PER_MINUTE=0
PUBLIC_DAILY_LIMIT=0
CV_TIMEOUT_SECONDS=30
# Milestone 15: OCR scanned CVs with Apple Vision when the PDF has no text layer
# (macOS + `uv sync --extra ocr`; elsewhere a scanned CV keeps the "no extractable text" error)
CV_OCR_ENABLED=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-career-platform

# Milestone 13: taxonomy path, alias learning, and resumable embedding batches
# Empty means data/taxonomy, relative to the working directory.
SKILL_DATA_DIR=
SKILL_ALIAS_LEARNING=true
SKILL_ALIAS_AUTO_CONFIDENCE=0.9
SKILL_ALIAS_NEW_CONFIDENCE=0.7
SKILL_ALIAS_BATCH_SIZE=40
EMBEDDING_BATCH_SIZE=20
EMBEDDING_REQUESTS_PER_MINUTE=0
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_SECONDS=20
