APP_ENV=development
DATABASE_URL=postgresql+psycopg://career:career@postgres:5432/career
READONLY_DATABASE_URL=postgresql+psycopg://career_readonly:change-me@postgres:5432/career
POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_READONLY_USER=career_readonly
POSTGRES_READONLY_PASSWORD=change-me
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_STRUCTURED_OUTPUT_METHOD=function_calling
DEEPSEEK_THINKING=disabled
LLM_MAX_RETRIES=2
LLM_BATCH_SIZE=8
LLM_REQUESTS_PER_MINUTE=0
LLM_STRUCTURED_FAST_PATH=true
LLM_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
AGENT_SEARCH_LIMIT=5
AGENT_TOOL_MAX_RETRIES=1
SQL_MAX_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=3000
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=30
HYBRID_CANDIDATE_LIMIT=20
RRF_K=60
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_RETRIES=1
RERANKER_MAX_CANDIDATES=20
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jobs
QDRANT_TIMEOUT_SECONDS=10
MAX_IMPORT_BYTES=1000000
MAX_CV_BYTES=2000000
MAX_CV_PAGES=5
CV_MATCH_CANDIDATES=50
CV_MATCH_SEMANTIC_WEIGHT=0.6
CV_TIMEOUT_SECONDS=30
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-career-platform

# Milestone 13: taxonomy path, alias learning, and resumable embedding batches
SKILL_DATA_DIR=
SKILL_ALIAS_LEARNING=true
SKILL_ALIAS_AUTO_CONFIDENCE=0.9
SKILL_ALIAS_BATCH_SIZE=40
EMBEDDING_BATCH_SIZE=20
EMBEDDING_REQUESTS_PER_MINUTE=0
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_SECONDS=20
